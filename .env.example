# MongoDB Connection
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Admin Panel Security
ADMIN_PASSWORD=change-this-password

# NextAuth Configuration
# Run `openssl rand -base64 32` to generate a secret
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Discord OAuth
# Create an application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Discord Notifications (Webhooks)
# Optional: Set these to receive notifications in Discord
DISCORD_SUBMISSION_WEBHOOK_URL=your-webhook-url-here
DISCORD_STATUS_WEBHOOK_URL=your-webhook-url-here